# Vertex AI (LLM provider chinh - tang 2 llm-attribute-normalization)
# Dat file service-account JSON vao thu muc secrets/ (khong commit) roi tro
# GOOGLE_APPLICATION_CREDENTIALS toi file do. VERTEX_PROJECT_ID co the de
# trong - se tu doc "project_id" trong file JSON neu khong khai bao rieng.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/vertex-service-account.json
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# DeepSeek (LLM provider fallback khi Vertex AI het quota/loi)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# cloakBrowser (lop fetch/render dung chung - stealth-fetch)
# Duong dan toi executable cloakBrowser da cai dat. Neu de trong, fallback ve
# Chromium mac dinh cua Playwright (KHONG co kha nang chong fingerprint).
CLOAKBROWSER_EXECUTABLE_PATH=

# Site probing
SITEMAP_RELIABILITY_THRESHOLD=0.8
SITEMAP_SAMPLE_SIZE=10

# So san pham xu ly song song (tang 1/1.5/2). Phan FETCH luon tuan tu 1 luong
# du dat bao nhieu - do thuc te cho thay fetch song song lam CHAM DI va gay
# timeout vi server doi thu bop bang thong (xem docs/pipeline.md).
# 4 la muc hop ly: cao hon gan nhu khong nhanh them vi tran that la quota LLM.
CRAWL_WORKERS=4

# Output
OUTPUT_DIR=./output

# --- Tang web (docker compose up) -------------------------------------------

# Kho du lieu. Trong container no nam tren VOLUME chu khong trong image: xoa va
# dung lai container thi snapshot va ket qua trich xuat van con.
CRAWL_DB_PATH=./crawl.db

# Khoa LLM va file xac thuc KHONG duoc nuong vao image - chung di vao luc chay
# qua chinh file .env nay (docker-compose khai `env_file`). File
# service-account cua Vertex duoc doc qua GOOGLE_APPLICATION_CREDENTIALS o
# tren; trong container, tro no vao mot duong dan duoc mount, vi du:
#
#     volumes:
#       - ./secrets:/run/secrets:ro
#     GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/vertex-service-account.json
#
# Worker kiem cau hinh nay LUC KHOI DONG va dung ngay neu thieu, thay vi hong
# giua mot luot crawl 33-70 phut.
